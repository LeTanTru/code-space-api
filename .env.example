# Application Settings
PORT=8080
NODE_ENV=development
API_PREFIX=api/v1
LOG_LEVEL=debug

# MySQL Database Connection String
DATABASE_URL="mysql://root:rootpassword@localhost:3306/codespace_db?parseTime=true"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="c8e6a1b2d3f4e5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0"
JWT_REFRESH_SECRET="f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a6f5e4d3c2b1a0f9e8"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:5173,vscode-webview://*"

# SMTP Email Delivery (optional — when unset, OTP emails are logged to console)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"

# Rate Limiting (Throttler — TTL in ms, limit in requests)
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
